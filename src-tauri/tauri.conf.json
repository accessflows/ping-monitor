{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ping Monitor",
  "version": "0.1.0",
  "identifier": "com.accessflows.pingmonitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetPulse · Ping Monitor",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/accessflows/ping-monitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRkI2M0ZFREU0RUZBQTkKUldTcCtrN2UvbVA3b0wvbnRkQkk0eE04Yng1V2U1N08ycTBxMUVGNkxCU0pwbXFZSlI0WEdzSDgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
